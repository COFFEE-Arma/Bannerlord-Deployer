# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Compose project name — prefixes container names so multiple installs can coexist
COMPOSE_PROJECT_NAME=bl-coop

# Must match the gameserver container name Compose creates.
# With the default compose file this is "${COMPOSE_PROJECT_NAME}-gameserver".
GAMESERVER_CONTAINER=bl-coop-gameserver

# Set to 1 if the server exe refuses to start headless and needs a virtual display
USE_XVFB=0

# Anonymous usage telemetry (install count). Set to 0 to disable.
# TELEMETRY_ENABLED=0
# TELEMETRY_URL=https://deployer-telemetry.arma.coffee/v1/heartbeat
